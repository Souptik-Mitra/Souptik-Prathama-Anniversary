# ============================================================
# Storage & Backend Configuration
# ============================================================
# In Phase 1 / Demo Mode:
# If these variables are left blank, the website automatically
# uses client-side browser storage (IndexedDB / LocalStorage)
# so you can upload and test photos immediately without a backend!
#
# To enable cloud persistence across all devices in Phase 2,
# choose either Supabase OR Firebase and configure below:

# --- Option A: Supabase Storage ---
# VITE_STORAGE_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
# VITE_SUPABASE_BUCKET=scrapbook-photos

# --- Option B: Firebase Storage ---
# VITE_STORAGE_PROVIDER=firebase
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_APP_ID=your-app-id

# --- Scrapbook Settings ---
# VITE_MAX_UPLOAD_SIZE_MB=10
# VITE_ALLOW_PUBLIC_UPLOADS=true
